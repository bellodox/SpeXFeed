# SpeXFeed ROD Helper Service — Environment Variables
# Copy this file to .env and fill in the actual values.

# ROD Core RPC connection
ROD_RPC_USER=user
ROD_RPC_PASSWORD=pass
ROD_RPC_HOST=localhost
ROD_RPC_PORT=11999

# ROD wallet name (loaded via loadwallet RPC)
ROD_WALLET_NAME=spexfeed

# Wallet encryption passphrase (used by seed-relays-init.js)
ROD_WALLET_PASSPHRASE=

# Express server port
SERVER_PORT=3000
